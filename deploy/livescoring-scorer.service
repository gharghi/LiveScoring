[Unit]
Description=LiveScoring scorer worker
After=network.target postgresql.service

[Service]
Type=simple
User=livescoring
Group=livescoring
WorkingDirectory=/srv/livescoring
EnvironmentFile=/etc/livescoring.env
ExecStart=/srv/livescoring/venv/bin/python /srv/livescoring/score_worker.py --interval 1
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/livescoring/runtime

[Install]
WantedBy=multi-user.target
