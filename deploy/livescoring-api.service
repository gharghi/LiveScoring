[Unit]
Description=LiveScoring Django API
After=network.target

[Service]
Type=simple
User=livescoring
Group=livescoring
WorkingDirectory=/srv/livescoring
Environment=LIVE_SCORING_EVENTS=/srv/livescoring/runtime/events.jsonl
Environment=LIVE_SCORING_DB=/srv/livescoring/runtime/live-scoring.sqlite3
EnvironmentFile=/etc/livescoring.env
ExecStart=/srv/livescoring/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8100 --access-logfile - --error-logfile - live_django.wsgi:application
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/livescoring/runtime

[Install]
WantedBy=multi-user.target
